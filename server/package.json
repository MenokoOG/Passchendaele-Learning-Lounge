{
  "name": "google-python-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --esm src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "scrape:links": "ts-node src/scripts/scrape_links.ts",
    "clean": "rimraf dist node_modules",
    "seed": "node ./seed.cjs",
    "start:worker": "ts-node -r dotenv/config src/worker/scrapeWorker.ts",
    "test": "NODE_ENV=test jest --detectOpenHandles",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "axios": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.8.2",
    "jsdom": "^22.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.7.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pnpm": "10.25.0",
    "puppeteer": "^24.32.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.12",
    "@types/jsdom": "^27.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "rimraf": "^5.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
